// Cấu hình schema cho DB

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  universityId String?              @unique
  username     String               @unique
  email        String               @unique
  password     String
  fullName     String
  role         Role                 @default(STUDENT)
  debtAmount   Float                @default(0)
  dueDate      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  payments     PaymentTransaction[]
  cards        RfidCard[]
}

model RfidCard {
  id          String           @id @default(uuid()) @db.Uuid
  uid         String           @unique
  status      CardStatus       @default(ACTIVE)
  isGuestCard Boolean          @default(false)
  userId      String?          @db.Uuid
  sessions    ParkingSession[]
  user        User?            @relation(fields: [userId], references: [id])
}

model ParkingZone {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique
  name             String
  capacity         Int
  currentOccupancy Int              @default(0)
  allowedRoles     Role[]
  sessions         ParkingSession[]
  slots            ParkingSlot[]
}

model ParkingSlot {
  id          String      @id @default(uuid()) @db.Uuid
  zoneId      String      @db.Uuid
  sensorCode  String      @unique
  status      SlotStatus  @default(EMPTY)
  lastUpdated DateTime    @default(now())
  zone        ParkingZone @relation(fields: [zoneId], references: [id])
}

model PricingPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  role          Role
  basePrice     Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
}

model ParkingSession {
  id              String              @id @default(uuid()) @db.Uuid
  cardId          String              @db.Uuid
  zoneId          String?             @db.Uuid
  checkinTime     DateTime            @default(now())
  licensePlateIn  String?
  imageInUrl      String?
  checkoutTime    DateTime?
  licensePlateOut String?
  imageOutUrl     String?
  status          SessionStatus       @default(INITIATED)
  calculatedFee   Float               @default(0)
  paymentId       String?             @db.Uuid
  card            RfidCard            @relation(fields: [cardId], references: [id])
  payment         PaymentTransaction? @relation(fields: [paymentId], references: [id])
  zone            ParkingZone?        @relation(fields: [zoneId], references: [id])
}

model PaymentTransaction {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String?          @db.Uuid
  amount    Float
  status    PaymentStatus    @default(PENDING)
  method    PaymentMethod
  qrCodeUrl String?
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  ParkingSession[]
  user      User?            @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  STUDENT
  STAFF
  GUEST
  OPERATOR
}

enum CardStatus {
  ACTIVE
  TEMP_LOCKED
  LOCKED
}

enum SessionStatus {
  INITIATED
  PARKING
  CLOSED
  PENDING_PAYMENT
  PAID
  ANOMALOUS
}

enum SlotStatus {
  EMPTY
  OCCUPIED
  UNKNOWN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

enum PaymentMethod {
  BKPAY_QR
  CASH
}
