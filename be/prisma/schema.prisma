// Đây là file schema của Prisma
// Tìm hiểu thêm: https://pris.ly/d/prisma-schema
// File này định nghĩa cấu trúc DB và cách Prisma tương tác với DB đó
// Mình xài Supabase (PostgreSQL) nên provider là postgresql
// Client sẽ được generate ra ở thư mục ../generated/prisma để mình có thể import vào code và dùng để query DB

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Model User, tương ứng với bảng User trong DB
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String 
  role      String   @default("user")
  createdAt DateTime @default(now())
}
